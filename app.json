{
  "expo": {
    "name": "Qubitpacha",
    "slug": "qubitpacha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "qubitpacha",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#041A2D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quantika.app"
    },
    "android": {
      "package": "com.quantika.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
