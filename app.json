{
  "expo": {
    "name": "QubitPacha",
    "slug": "qubitpacha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "qubitpacha",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#041A2D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedrorojasf.qubitpacha"
    },
    "android": {
      "package": "com.pedrorojasf.qubitpacha"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a66fd90a-c4d4-4ffc-85a1-392c48c7c121"
      }
    },
    "owner": "pedrorojasf24"
  }
}
